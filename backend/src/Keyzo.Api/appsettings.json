{
  "Urls": "http://localhost:5080",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System": "Warning" }
    }
  },
  "Database": {
    "Host": "localhost",
    "Port": "3306",
    "Name": "keyzo",
    "User": "root"
  },
  "Jwt": {
    "Issuer": "keyzo-api",
    "Audience": "keyzo-web",
    "AccessMinutes": 30,
    "RefreshDays": 14
  },
  "Cors": { "Origins": [ "http://localhost:5173", "http://127.0.0.1:5173" ] },
  "Storage": { "Root": "uploads", "MaxBytes": 8388608 },
  "Jobs": { "Enabled": true },
  "AllowedHosts": "*"
}
